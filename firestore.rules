rules_version = '2';

// La discoteca es pública para leer; solo el dueño puede escribir.
// OWNER_UID tiene que coincidir con el de src/config.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(ownerId) {
      return request.auth != null
        && request.auth.uid == ownerId
        && ownerId == 'rK4orgfeviV2Fx5BMO7XF2g3SSG3';
    }

    match /discotecas/{ownerId}/discos/{discoId} {
      allow read: if true;
      allow delete: if isOwner(ownerId);
      allow create, update: if isOwner(ownerId)
        && request.resource.data.id == discoId
        && request.resource.data.title is string
        && request.resource.data.artist is string;
    }
  }
}
